# Dedicated ADREEM PostgreSQL database. Never point this at a shared project.
ADREEM_BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
ADREEM_BACKUP_DATABASE_CA_FILE=/secure/provider/postgresql-ca.pem
ADREEM_BACKUP_EXPECTED_HOST=HOST
ADREEM_BACKUP_EXPECTED_DATABASE=DATABASE

# External S3-compatible destination outside Contabo.
ADREEM_BACKUP_S3_ENDPOINT=https://OBJECT-ENDPOINT
ADREEM_BACKUP_S3_BUCKET=adreem-backups
ADREEM_BACKUP_S3_PREFIX=production/adreem
ADREEM_BACKUP_S3_REGION=us-east-1
ADREEM_BACKUP_FORBIDDEN_HOSTS=CONTABO_PUBLIC_IP,CONTABO_PRIVATE_IP
ADREEM_BACKUP_S3_ACCESS_KEY_ID=CREATE_MULTIPART_HEAD_ACCESS_KEY
ADREEM_BACKUP_S3_SECRET_ACCESS_KEY=CREATE_MULTIPART_HEAD_SECRET_KEY

# Separate read-only credentials used only by the restore host.
ADREEM_RESTORE_SOURCE_S3_ACCESS_KEY_ID=READ_BACKUP_ACCESS_KEY
ADREEM_RESTORE_SOURCE_S3_SECRET_ACCESS_KEY=READ_BACKUP_SECRET_KEY

# Include Supabase Storage attachments. Keep true in production.
ADREEM_BACKUP_INCLUDE_STORAGE=true
ADREEM_STORAGE_S3_ENDPOINT=https://PROJECT.supabase.co/storage/v1/s3
ADREEM_ATTACHMENTS_BUCKET=adreem-attachments
ADREEM_STORAGE_S3_REGION=local
ADREEM_STORAGE_S3_ACCESS_KEY_ID=READ_ONLY_STORAGE_ACCESS_KEY
ADREEM_STORAGE_S3_SECRET_ACCESS_KEY=READ_ONLY_STORAGE_SECRET_KEY

# Preferred encryption: age needs only a public recipient on Contabo.
ADREEM_BACKUP_ENCRYPTION=age
ADREEM_BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT

# AES-256-GCM fallback. Use only when age is unavailable.
# ADREEM_BACKUP_ENCRYPTION=aes-256-gcm
# ADREEM_BACKUP_PASSPHRASE=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Separate secret authenticating the manifest. Store an offline copy.
ADREEM_BACKUP_MANIFEST_HMAC_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Restore drill: a separate, empty, disposable PostgreSQL database only.
# Its cluster must already contain every role recorded in the signed manifest.
# For an isolated database-only drill, see docs/adreem-restore-bootstrap-roles.sql.
ADREEM_RESTORE_DATABASE_URL=postgresql://USER:PASSWORD@RESTORE_HOST:5432/EMPTY_DATABASE?sslmode=verify-full
ADREEM_RESTORE_DATABASE_CA_FILE=/secure/provider/restore-postgresql-ca.pem
ADREEM_RESTORE_EXPECTED_HOST=RESTORE_HOST
ADREEM_RESTORE_EXPECTED_DATABASE=EMPTY_DATABASE
ADREEM_RESTORE_CONFIRM=RESTORE_TO_EMPTY_ADREEM_DATABASE

# A separate, empty attachment bucket used by the restore drill.
ADREEM_RESTORE_STORAGE_S3_ENDPOINT=https://RESTORE_PROJECT.supabase.co/storage/v1/s3
ADREEM_RESTORE_ATTACHMENTS_BUCKET=adreem-restore-attachments
ADREEM_RESTORE_STORAGE_EXPECTED_HOST=RESTORE_PROJECT.supabase.co
ADREEM_RESTORE_STORAGE_EXPECTED_BUCKET=adreem-restore-attachments
ADREEM_RESTORE_STORAGE_S3_REGION=local
ADREEM_RESTORE_STORAGE_S3_ACCESS_KEY_ID=RESTORE_WRITE_VERIFY_DELETE_ACCESS_KEY
ADREEM_RESTORE_STORAGE_S3_SECRET_ACCESS_KEY=RESTORE_WRITE_VERIFY_DELETE_SECRET_KEY
ADREEM_RESTORE_STORAGE_FORBIDDEN_HOSTS=CONTABO_PUBLIC_IP,CONTABO_PRIVATE_IP

# Needed only to restore an age-encrypted archive. Keep this key off Contabo.
ADREEM_BACKUP_AGE_IDENTITY_FILE=/secure/offline/location/age-identity.txt

# Unit tests only. The tools accept this only with NODE_ENV=test, loopback hosts,
# and sslmode=disable. Never set it on a production or restore-drill host.
# ADREEM_BACKUP_LOCAL_TEST_MODE=true
