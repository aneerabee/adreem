# Keep the real file outside Git and set its mode to 600.
ADREEM_LEGACY_SUPABASE_URL=https://legacy-project.supabase.co
ADREEM_LEGACY_SUPABASE_EXPECTED_PROJECT_REF=legacy-project
ADREEM_LEGACY_SUPABASE_EXPECTED_HOST=legacy-project.supabase.co
ADREEM_LEGACY_SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-key
ADREEM_LEGACY_ATTACHMENTS_BUCKET=adreem-attachments

ADREEM_V3_SUPABASE_URL=https://dedicated-adreem.supabase.co
ADREEM_V3_SUPABASE_EXPECTED_PROJECT_REF=dedicated-adreem
ADREEM_V3_SUPABASE_EXPECTED_HOST=dedicated-adreem.supabase.co
ADREEM_V3_SUPABASE_SERVICE_ROLE_KEY=dedicated-service-role-key
ADREEM_V3_ATTACHMENTS_BUCKET=adreem-attachments

# Direct connection or transaction pooler connection for read-only catalog preflight.
# Keep sslmode=verify-full and use the matching Supabase CA file.
ADREEM_V3_DATABASE_URL=postgresql://postgres:password@db.dedicated-adreem.supabase.co:5432/postgres?sslmode=verify-full
ADREEM_V3_EXPECTED_DATABASE_HOST=db.dedicated-adreem.supabase.co
ADREEM_V3_DATABASE_CA_FILE=/private/path/prod-supabase-ca.crt

ADREEM_V3_MIGRATION_USERS_FILE=/private/path/adreem-migration-users.json
ADREEM_V3_MIGRATION_CHECKPOINT_FILE=/private/path/adreem-migration-checkpoint.json
