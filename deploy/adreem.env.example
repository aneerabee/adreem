NODE_ENV=production
ADREEM_AUTH_MODE=supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=keep-this-only-on-the-server
ADREEM_WEB_ALLOWED_ORIGIN=https://adreem.example.com
ADREEM_API_PUBLIC_ORIGIN=https://adreem.example.com
ADREEM_API_HOST=127.0.0.1
ADREEM_API_PORT=8787
ADREEM_TRUST_PROXY=true
ADREEM_USERS_FILE=/home/argaz/apps/adreem/adreem-users.json
ADREEM_BACKUP_DIR=/home/argaz/apps/adreem/backups
ADREEM_BACKUP_LIMIT=60
ADREEM_AUDIT_LOG_FILE=/home/argaz/apps/adreem/adreem-audit.jsonl
ADREEM_ATTACHMENTS_BUCKET=adreem-attachments
ADREEM_RUNTIME_TEST_EMAIL=owner@example.com
ADREEM_RUNTIME_TEST_PASSWORD=owner-password
